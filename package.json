{
  "name": "node-red-contrib-jev-decisions",
  "version": "0.2.0",
  "description": "Native Node-RED nodes for versioned Jev decisions, review routing and provenance.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gbesse/node-red-contrib-jev-decisions.git"
  },
  "files": [
    "src",
    "nodes",
    "app.js",
    "api.js",
    "packs",
    "examples",
    "element-templates",
    "README.md",
    "LICENSE",
    "docs"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "typecheck": "tsc --noEmit --skipLibCheck --strict --target ES2022 --module NodeNext docs/public-api-types.mts",
    "demo": "node examples/demo.mjs"
  },
  "dependencies": {
    "@gbesse/decisionpacks": "git+https://github.com/gbesse/decisionpacks.git#3c90b6e667c16653b9a6ae00b376df9bddbd8461"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "node-red": "5.0.7",
    "node-red-node-test-helper": "0.3.6"
  },
  "node-red": {
    "nodes": {
      "jev-decide": "nodes/jev-decide.cjs"
    }
  }
}
